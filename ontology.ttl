# NG136 ontology, draft v0.3: classes, properties, fixed value lists and clinical concepts.
# Taken from ng136_graph.ttl without the record layer (the rec: subjects).
# Source: ng136_graph.ttl. Generated by build_graph.py from ng136_records.json and ng136_mapping.py.
# Namespace example.org is a placeholder until a permanent base address is chosen.

ng: a owl:Ontology ;
    dcterms:title "NG136 hypertension guideline ontology (draft v0.3)"@en ;
    rdfs:comment "Three layers: guideline (recommendations), rule (conditions and actions) and concept (clinical things). Logic is data, not OWL axioms (D1)."@en .

ng:Guideline a owl:Class ;
    ng:layer "guideline" .

ng:Recommendation a owl:Class ;
    ng:layer "guideline" .

ng:ExternalGuideline a owl:Class ;
    ng:layer "guideline" .

ng:ExternalReference a owl:Class ;
    ng:layer "guideline" .

ng:ConditionGroup a owl:Class ;
    ng:layer "rule" .

ng:Condition a owl:Class ;
    ng:layer "rule" .

ng:Action a owl:Class ;
    ng:layer "rule" .

ng:BloodPressureTarget a owl:Class ;
    ng:layer "rule" .

ng:TargetChoice a owl:Class ;
    ng:layer "rule" .

ng:ClinicalConcept a owl:Class ;
    ng:layer "concept" .

ng:Disease a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:PatientCharacteristic a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Measurement a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:FindingOrSymptom a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:DrugClass a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Investigation a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Procedure a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Situation a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Substance a owl:Class ;
    rdfs:subClassOf ng:ClinicalConcept ;
    ng:layer "concept" .

ng:Certainty a owl:Class ;
    rdfs:subClassOf ng:Status .

ng:Course a owl:Class ;
    rdfs:subClassOf ng:Status .

ng:MedicationState a owl:Class ;
    rdfs:subClassOf ng:Status .

ng:Preference a owl:Class ;
    rdfs:subClassOf ng:Status .

ng:Status a owl:Class .

ng:hasRecommendation a owl:ObjectProperty ;
    rdfs:domain ng:Guideline ;
    rdfs:range ng:Recommendation .

